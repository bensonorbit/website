{
  "name": "bensonorbit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @bensonorbit/web dev",
    "dev:studio": "pnpm --filter @bensonorbit/studio dev",
    "build": "pnpm --filter @bensonorbit/web build",
    "build:studio": "pnpm --filter @bensonorbit/studio build",
    "start": "pnpm --filter @bensonorbit/web start",
    "typegen": "pnpm --filter @bensonorbit/studio typegen",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "^2.1.10",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "5.8.3",
    "ultracite": "7.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "npx ultracite fix --no-error-on-unmatched-pattern"
    ]
  }
}
